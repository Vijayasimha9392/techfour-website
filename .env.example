# TechFour contact form — email delivery via Resend (https://resend.com)
# These are read only on the server. Never prefix them with VITE_ (that would expose them to the browser).

# Resend API key (Resend dashboard → API Keys)
RESEND_API_KEY=re_your_api_key_here

# Inbox(es) that receive contact form messages. Comma-separate multiple addresses.
CONTACT_TO_EMAIL=your-team-email@example.com

# Sender shown on the email. Must use a domain verified in Resend.
# Leave empty to use Resend's test sender (onboarding@resend.dev), which only
# delivers to the email address of your own Resend account.
CONTACT_FROM_EMAIL="TechFour Website <hello@your-domain.com>"
